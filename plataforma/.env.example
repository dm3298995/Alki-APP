# ===== ALKI Gestión — configuración (copia este archivo como .env) =====
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# Dirección pública con https (se usa en los enlaces de los correos y para la protección CSRF)
APP_ORIGIN=https://gestion.alki.casa
# Nginx hace de proxy delante: 1 = fiarse de su cabecera X-Forwarded-For
TRUST_PROXY=1
# Clave maestra de cifrado (64 caracteres hex). Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# GUÁRDALA en un lugar seguro: sin ella no se pueden descifrar el MFA ni el token de Homming.
APP_SECRET=
# Administrador inicial
ADMIN_EMAIL=daniel@alki.casa
# Sesiones
SESSION_IDLE_MIN=30
SESSION_MAX_HOURS=12
# Correo saliente (recuperar contraseña e invitaciones). SMTP con TLS en el puerto 465.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ALKI Gestión <no-responder@alki.casa>
# Copias de seguridad
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=30
UPLOAD_MAX_MB=10
